# AquaMark configuration — copy this file to `.env` and fill in your token.
#   cp .env.example .env   then edit .env
#
# Environment variables always override values in this file.

# REQUIRED — the token you got from @BotFather on Telegram.
BOT_TOKEN=123456789:AAF-your-bot-token-here

# OPTIONAL — Telegram app credentials from my.telegram.org.
# The Bot API only needs the token; these are kept for optional
# advanced integrations and are safe to leave unset.
#API_ID=12345678
#API_HASH=0123456789abcdef0123456789abcdef

# OPTIONAL — your numeric Telegram user id (see @userinfobot).
# Grants owner-only admin commands: /broadcast /users /ban /unban.
#OWNER_ID=123456789

# OPTIONAL — log verbosity: DEBUG, INFO (default), WARNING, ERROR.
#AQM_LOG_LEVEL=INFO

# OPTIONAL — small-caps UI font on all bot text ("Travel vote" style).
# Set to 0 to restore the plain alphabet.
#AQM_UI_FONT=1

# OPTIONAL — custom Telegram Premium emojis in messages and buttons (1=on).
# Requires the bot to have a Fragment collectible username. If IDs are not
# set (or anything fails) the bot silently falls back to normal emojis.
#AQM_USE_CUSTOM_EMOJIS=1

# OPTIONAL — local Bot API server for files >20 MB (see LARGE-FILES.md).
# Raises receive/send caps from 20 MB / 50 MB to 2000 MB / 2000 MB.
#AQM_API_BASE=http://127.0.0.1:8081
# Fine-tuning (defaults auto-raise when AQM_API_BASE is set):
#AQM_MAX_IN_MB=2000
#AQM_MAX_OUT_MB=1900
